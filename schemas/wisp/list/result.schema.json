{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gc wisp list result",
  "type": "object",
  "required": ["schema_version", "ok", "roots"],
  "properties": {
    "schema_version": { "const": "1" },
    "ok": { "const": true },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "issue_type", "assignee", "ref", "metadata"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "issue_type": { "const": "task" },
          "assignee": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "metadata": {
            "type": "object",
            "required": ["gc.kind", "gc.formula_name"],
            "properties": {
              "gc.kind": { "enum": ["wisp", "workflow"] },
              "gc.formula_name": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
